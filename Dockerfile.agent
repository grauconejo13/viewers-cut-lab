FROM python:3.11-slim

WORKDIR /app

COPY agent/requirements.txt /app/agent/requirements.txt
COPY agent/requirements-mcp.txt /app/agent/requirements-mcp.txt

RUN python -m venv /app/agent/.adk-venv \
    && /app/agent/.adk-venv/bin/pip install --no-cache-dir -r /app/agent/requirements.txt \
    && python -m venv /app/agent/.venv \
    && /app/agent/.venv/bin/pip install --no-cache-dir -r /app/agent/requirements-mcp.txt

COPY agent /app/agent

ENV PORT=8080
EXPOSE 8080

CMD ["/app/agent/.adk-venv/bin/python", "/app/agent/http_api.py"]
